{
  "name": "plotter",
  "version": "1.0.0",
  "homepage": "./",
  "main": "./index.js",
  "author": "LazarPetrovic1",
  "description": "An Electron-based graph plotter",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.126",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "plotly.js": "^3.4.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^7.13.0",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "concurrently \"cross-env BROWSER=none npm run start:react\" \"wait-on http://127.0.0.1:3000 && cross-env NODE_ENV=development electron .\"",
    "start:react": "react-scripts start",
    "build": "react-scripts build",
    "package": "cross-env INLINE_RUNTIME_CHUNK=false NODE_ENV=production electron-builder",
    "serve": "serve -s build",
    "patch": "node update-version.js --type patch",
    "major": "node update-version.js --type major",
    "minor": "node update-version.js --type minor",
    "prod": "npm run build && npm run package"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.graph.plotly",
    "extends": null,
    "productName": "Graph Plotter",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "index.js",
      "package.json",
      "icon.png",
      ".env",
      "preload.js",
      "preload.ts"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/electron": "^1.6.12",
    "@types/plotly.js": "^3.0.10",
    "@types/react-plotly.js": "^2.6.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.0",
    "electron-builder": "^26.8.1",
    "electron-debug": "^4.1.0",
    "electron-devtools-installer": "^4.0.0",
    "wait-on": "^9.0.4"
  }
}
